# Choose ONE provider (set LLM_PROVIDER + the matching API key).
# The agent uses whichever you configure.

# ─── Option 1: Google Gemini (FREE tier available, recommended) ──────────
# Get a key at https://aistudio.google.com/apikey (no billing required for free tier).
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash-lite
# GOOGLE_API_KEY=

# ─── Option 2: OpenAI (paid — needs billing on your account) ─────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ─── Option 3: Anthropic Claude (paid) ───────────────────────────────────
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Optional: override max questions per session (default 5)
MAX_QUESTIONS=5
