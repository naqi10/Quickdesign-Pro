# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# 1. Sign up at https://neon.tech (free tier works)
# 2. Create a new project — copy the "Pooled connection" string
# 3. Paste it below (looks like: postgresql://user:pass@host.neon.tech/dbname?sslmode=require)
DATABASE_URL=""

# ─── Auth.js v5 ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
AUTH_SECRET=""

# In production set this to your real domain (https://yourdomain.com)
# In dev, leave blank — Auth.js auto-detects http://localhost:3000
AUTH_URL=""

# ─── Secrets encryption ────────────────────────────────────────────────────
# 32-byte master key (base64) used to encrypt user-supplied API keys at rest
# via AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: rotating this invalidates every stored user API key.
ENCRYPTION_KEY=""

# ─── Interview Coach (Python LangGraph service) ────────────────────────────
# URL of the running Python coach service (see interview-coach/README.md).
# Default fits the Docker compose setup; override for prod.
COACH_URL="http://localhost:8000"

# ─── Rate limiting + wallet protection (Upstash Redis, free tier) ─────────
# Without these set, the limiter FAILS OPEN (dev works with zero setup).
# In production, sign up at https://upstash.com → create a Redis DB →
# copy the REST URL + token from the database dashboard.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Optional tuning (sensible defaults):
# RATE_LIMIT_PER_MIN="30"        # per-user sliding window
# FREE_POOL_DAILY_CAP="10000"    # total project-pool AI calls / UTC day

# ─── Google OAuth (optional but recommended) ────────────────────────────────
# 1. Visit https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID → Web application
# 3. Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google   (dev)
#      https://yourdomain.com/api/auth/callback/google  (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI providers (multi-provider fallback) ────────────────────────────────
# Set AI_PROVIDER to your preferred one. The app tries it first, then falls
# back to any OTHER provider that has a key below if the first rate-limits.
# Add 2-3 free keys so you basically never hit a wall while testing.
AI_PROVIDER="google"
AI_MODEL="gemini-2.0-flash-lite"
AI_FALLBACK_MODELS="gemini-2.0-flash"
AI_CONCURRENCY="2"

# Free keys (add as many as you like — order of fallback is google→groq→cerebras→deepseek→openai)
GOOGLE_API_KEY=""        # https://aistudio.google.com/apikey  (1500 req/day free)
GROQ_API_KEY=""          # https://console.groq.com/keys       (fast, 30 RPM free)
CEREBRAS_API_KEY=""      # https://cloud.cerebras.ai            (fastest, generous free)
DEEPSEEK_API_KEY=""      # https://platform.deepseek.com       (cheap paid)
OPENAI_API_KEY=""        # https://platform.openai.com         (best quality, paid)
