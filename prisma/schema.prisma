// Prisma schema — Resume Generator
// DB: Neon Postgres (serverless)
// Auth: Auth.js v5 standard tables (User, Account, Session, VerificationToken)
// Domain: Resume table per user

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js standard tables ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Credentials provider — hashed password
  passwordHash  String?
  // Plan tier — drives feature gating later
  plan          Plan      @default(FREE)
  // Free credits drawn from the project's API pool. Decrements on each AI
  // call when the user has NO personal key for the provider. Default 5.
  freeCreditsRemaining Int @default(5)
  // Preferred default model for the chat assistant (set in settings).
  defaultChatModel String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  resumes  Resume[]
  apiKeys  UserApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain ──────────────────────────────────────────────────────────────────

model Resume {
  id         String   @id @default(cuid())
  userId     String
  clientName String
  jobTitle   String
  templateId String   @default("classic")
  // Full ResumeData blob — keeps schema flexible for AI evolution
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── BYO API keys ────────────────────────────────────────────────────────────
// Per-user, per-provider API keys. encryptedKey is "iv:authTag:ciphertext"
// (each part base64) — AES-256-GCM with the server-side ENCRYPTION_KEY.
// Plaintext keys NEVER leave the server.

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  // 'google' | 'openai' | 'anthropic' | 'groq' | 'cerebras' | 'deepseek'
  provider     String
  encryptedKey String   @db.Text
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

enum Plan {
  FREE
  PRO
  AGENCY
}
